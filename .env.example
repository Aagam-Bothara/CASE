# CASE Optimizer - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# REALTIME PRICING CONFIGURATION
# =============================================================================
# Enable/disable live pricing fetches from cloud providers
# Values: 1, true, yes (enabled) | 0, false, no (disabled)
# When disabled, uses fallback/stub pricing estimates
REALTIME_PRICING=0

# =============================================================================
# AWS CREDENTIALS (Optional - for AWS Pricing API)
# =============================================================================
# Required for live AWS Fargate and S3 pricing
# Get credentials from: https://console.aws.amazon.com/iam/
# Permissions needed: pricing:GetProducts (read-only)
#
# SECURITY: These should be from an IAM user with MINIMAL permissions
# Recommended: Create a dedicated IAM user with only Pricing API access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# AZURE CREDENTIALS (Optional - for Azure Pricing API)
# =============================================================================
# Azure Retail Pricing API is public and requires no authentication
# No credentials needed - API calls are anonymous

# =============================================================================
# GCP CREDENTIALS (Optional - for GCP Cloud Billing API)
# =============================================================================
# Required for live GCP Cloud Run and Storage pricing
# Get API key from: https://console.cloud.google.com/apis/credentials
# Enable: Cloud Billing API
#
# SECURITY: Restrict this API key to:
# - Cloud Billing API only
# - IP restrictions (if possible)
# - HTTP referrer restrictions
GCP_BILLING_API_KEY=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Backend API port (default: 8000)
PORT=8001

# Environment: development, production
ENV=development

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
